APP_NAME=Flight Menu API
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
APP_PORT=8000

# Local API + docker-compose.dev.yml → use localhost:5435
# docker-compose.prod.yml overrides DB_HOST/DB_PORT inside the api container
DB_HOST=localhost
DB_PORT=5435
DB_NAME=flight_menu
DB_USERNAME=flight_menu
DB_PASSWORD=flight_menu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
